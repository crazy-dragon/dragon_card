[
  {
    "item_order": 1,
    "data": {
      "number": 1,
      "name": "乾",
      "pinyin": "qián",
      "upper": "乾",
      "lower": "乾",
      "lines": "111111",
      "structure": "上乾下乾",
      "judgment": "元，亨，利，贞。",
      "meaning": "刚健中正，自强不息。象征天，劝人奋发进取、积德行仁。"
    }
  },
  {
    "item_order": 2,
    "data": {
      "number": 2,
      "name": "坤",
      "pinyin": "kūn",
      "upper": "坤",
      "lower": "坤",
      "lines": "000000",
      "structure": "上坤下坤",
      "judgment": "元亨，利牝马之贞。君子有攸往，先迷后得主，利。",
      "meaning": "柔顺包容，厚德载物。象征地，劝人宽厚承载、顺势而为。"
    }
  },
  {
    "item_order": 3,
    "data": {
      "number": 3,
      "name": "屯",
      "pinyin": "zhūn",
      "upper": "坎",
      "lower": "震",
      "lines": "010001",
      "structure": "上坎下震",
      "judgment": "元亨，利贞。勿用有攸往，利建侯。",
      "meaning": "万物始生，艰难初创。如草穿土，宜固本积渐、求助贤明。"
    }
  },
  {
    "item_order": 4,
    "data": {
      "number": 4,
      "name": "蒙",
      "pinyin": "méng",
      "upper": "艮",
      "lower": "坎",
      "lines": "100010",
      "structure": "上艮下坎",
      "judgment": "亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
      "meaning": "蒙昧待启，须受教育。山下出泉，宜虚心求教、启蒙养正。"
    }
  },
  {
    "item_order": 5,
    "data": {
      "number": 5,
      "name": "需",
      "pinyin": "xū",
      "upper": "坎",
      "lower": "乾",
      "lines": "010111",
      "structure": "上坎下乾",
      "judgment": "有孚，光亨，贞吉。利涉大川。",
      "meaning": "等待时机，饮食宴乐。云上于天，宜耐心蓄势、待时而动。"
    }
  },
  {
    "item_order": 6,
    "data": {
      "number": 6,
      "name": "讼",
      "pinyin": "sòng",
      "upper": "乾",
      "lower": "坎",
      "lines": "111010",
      "structure": "上乾下坎",
      "judgment": "有孚，窒。惕中吉。终凶。利见大人，不利涉大川。",
      "meaning": "争讼不已，惕惧防凶。天与水违行，宜止争求和、慎防诉讼。"
    }
  },
  {
    "item_order": 7,
    "data": {
      "number": 7,
      "name": "师",
      "pinyin": "shī",
      "upper": "坤",
      "lower": "坎",
      "lines": "000010",
      "structure": "上坤下坎",
      "judgment": "贞，丈人，吉无咎。",
      "meaning": "兵众用师，任贤统众。地中有水，宜选将严明、纪律为先。"
    }
  },
  {
    "item_order": 8,
    "data": {
      "number": 8,
      "name": "比",
      "pinyin": "bǐ",
      "upper": "坎",
      "lower": "坤",
      "lines": "010000",
      "structure": "上坎下坤",
      "judgment": "吉。原筮，元永贞，无咎。不宁方来，后夫凶。",
      "meaning": "亲比相辅，择善而从。水在地上，宜诚信亲附、审时归依。"
    }
  },
  {
    "item_order": 9,
    "data": {
      "number": 9,
      "name": "小畜",
      "pinyin": "xiǎo xù",
      "upper": "巽",
      "lower": "乾",
      "lines": "110111",
      "structure": "上巽下乾",
      "judgment": "亨。密云不雨，自我西郊。",
      "meaning": "小有积蓄，密云未雨。风行天上，宜积蓄力量、待时而发。"
    }
  },
  {
    "item_order": 10,
    "data": {
      "number": 10,
      "name": "履",
      "pinyin": "lǚ",
      "upper": "乾",
      "lower": "兑",
      "lines": "111011",
      "structure": "上乾下兑",
      "judgment": "履虎尾，不咥人，亨。",
      "meaning": "履危而安，谨慎行事。履虎尾而不噬，宜循礼而行、临危不乱。"
    }
  },
  {
    "item_order": 11,
    "data": {
      "number": 11,
      "name": "泰",
      "pinyin": "tài",
      "upper": "坤",
      "lower": "乾",
      "lines": "000111",
      "structure": "上坤下乾",
      "judgment": "小往大来，吉亨。",
      "meaning": "天地交泰，阴阳和畅。宜通达顺势、上下交融。"
    }
  },
  {
    "item_order": 12,
    "data": {
      "number": 12,
      "name": "否",
      "pinyin": "pǐ",
      "upper": "乾",
      "lower": "坤",
      "lines": "111000",
      "structure": "上乾下坤",
      "judgment": "否之匪人，不利君子贞，大往小来。",
      "meaning": "天地不交，闭塞之世。宜韬光养晦、待否极泰来。"
    }
  },
  {
    "item_order": 13,
    "data": {
      "number": 13,
      "name": "同人",
      "pinyin": "tóng rén",
      "upper": "乾",
      "lower": "离",
      "lines": "111101",
      "structure": "上乾下离",
      "judgment": "同人于野，亨。利涉大川，利君子贞。",
      "meaning": "与人和同，协力同心。天火同明，宜广结同心、和同于人。"
    }
  },
  {
    "item_order": 14,
    "data": {
      "number": 14,
      "name": "大有",
      "pinyin": "dà yǒu",
      "upper": "离",
      "lower": "乾",
      "lines": "101111",
      "structure": "上离下乾",
      "judgment": "元亨。",
      "meaning": "富有大有，顺天休命。火在天上，宜居富守谦、善用其有。"
    }
  },
  {
    "item_order": 15,
    "data": {
      "number": 15,
      "name": "谦",
      "pinyin": "qiān",
      "upper": "坤",
      "lower": "艮",
      "lines": "000100",
      "structure": "上坤下艮",
      "judgment": "亨，君子有终。",
      "meaning": "谦虚守礼，尊而光。地中有山，宜谦逊自牧、终获其成。"
    }
  },
  {
    "item_order": 16,
    "data": {
      "number": 16,
      "name": "豫",
      "pinyin": "yù",
      "upper": "震",
      "lower": "坤",
      "lines": "001000",
      "structure": "上震下坤",
      "judgment": "利建侯行师。",
      "meaning": "欢愉和乐，顺动以乐。雷出地奋，宜备而能乐、不可耽逸。"
    }
  },
  {
    "item_order": 17,
    "data": {
      "number": 17,
      "name": "随",
      "pinyin": "suí",
      "upper": "兑",
      "lower": "震",
      "lines": "011001",
      "structure": "上兑下震",
      "judgment": "元亨利贞，无咎。",
      "meaning": "随时而动，从善随人。泽中有雷，宜择善而从、顺时变通。"
    }
  },
  {
    "item_order": 18,
    "data": {
      "number": 18,
      "name": "蛊",
      "pinyin": "gǔ",
      "upper": "艮",
      "lower": "巽",
      "lines": "100110",
      "structure": "上艮下巽",
      "judgment": "元亨，利涉大川。先甲三日，后甲三日。",
      "meaning": "弊乱待治，拯弊革新。山下有风，宜整饬积弊、振衰起敝。"
    }
  },
  {
    "item_order": 19,
    "data": {
      "number": 19,
      "name": "临",
      "pinyin": "lín",
      "upper": "坤",
      "lower": "兑",
      "lines": "000011",
      "structure": "上坤下兑",
      "judgment": "元，亨，利，贞。至于八月有凶。",
      "meaning": "临下亲民，阳气渐长。泽上有地，宜居上临下、以德临人。"
    }
  },
  {
    "item_order": 20,
    "data": {
      "number": 20,
      "name": "观",
      "pinyin": "guān",
      "upper": "巽",
      "lower": "坤",
      "lines": "110000",
      "structure": "上巽下坤",
      "judgment": "盥而不荐，有孚颙若。",
      "meaning": "观察省视，瞻仰风化。风行地上，宜静观其象、反观自省。"
    }
  },
  {
    "item_order": 21,
    "data": {
      "number": 21,
      "name": "噬嗑",
      "pinyin": "shì kè",
      "upper": "离",
      "lower": "震",
      "lines": "101001",
      "structure": "上离下震",
      "judgment": "亨。利用狱。",
      "meaning": "咬合去梗，明罚敕法。火雷相合，宜决断除碍、明断是非。"
    }
  },
  {
    "item_order": 22,
    "data": {
      "number": 22,
      "name": "贲",
      "pinyin": "bì",
      "upper": "艮",
      "lower": "离",
      "lines": "100101",
      "structure": "上艮下离",
      "judgment": "亨。小利有攸往。",
      "meaning": "文饰美化，质文相济。山下有火，宜饰外修内、文质彬彬。"
    }
  },
  {
    "item_order": 23,
    "data": {
      "number": 23,
      "name": "剥",
      "pinyin": "bō",
      "upper": "艮",
      "lower": "坤",
      "lines": "100000",
      "structure": "上艮下坤",
      "judgment": "不利有攸往。",
      "meaning": "剥落侵蚀，小人得势。山附于地，宜顺而止、勿妄进取。"
    }
  },
  {
    "item_order": 24,
    "data": {
      "number": 24,
      "name": "复",
      "pinyin": "fù",
      "upper": "坤",
      "lower": "震",
      "lines": "000001",
      "structure": "上坤下震",
      "judgment": "亨。出入无疾，朋来无咎。反复其道，七日来复，利有攸往。",
      "meaning": "一阳来复，生机回转。雷在地中，宜见机而动、反复其道。"
    }
  },
  {
    "item_order": 25,
    "data": {
      "number": 25,
      "name": "无妄",
      "pinyin": "wú wàng",
      "upper": "乾",
      "lower": "震",
      "lines": "111001",
      "structure": "上乾下震",
      "judgment": "元，亨，利，贞。其匪正有眚，不利有攸往。",
      "meaning": "不妄为，顺天合道。天下雷行，宜守正不妄、循理而行。"
    }
  },
  {
    "item_order": 26,
    "data": {
      "number": 26,
      "name": "大畜",
      "pinyin": "dà xù",
      "upper": "艮",
      "lower": "乾",
      "lines": "100111",
      "structure": "上艮下乾",
      "judgment": "利贞，不家食吉，利涉大川。",
      "meaning": "大畜其德，厚积笃实。山天相涵，宜止而能蓄、厚积成才。"
    }
  },
  {
    "item_order": 27,
    "data": {
      "number": 27,
      "name": "颐",
      "pinyin": "yí",
      "upper": "艮",
      "lower": "震",
      "lines": "100001",
      "structure": "上艮下震",
      "judgment": "贞吉。观颐，自求口实。",
      "meaning": "颐养正道，慎言节欲。山下有雷，宜养正颐德、谨言节食。"
    }
  },
  {
    "item_order": 28,
    "data": {
      "number": 28,
      "name": "大过",
      "pinyin": "dà guò",
      "upper": "兑",
      "lower": "巽",
      "lines": "011110",
      "structure": "上兑下巽",
      "judgment": "栋桡，利有攸往，亨。",
      "meaning": "过甚难支，独立不惧。泽灭木，宜非常之时、非常之为。"
    }
  },
  {
    "item_order": 29,
    "data": {
      "number": 29,
      "name": "坎",
      "pinyin": "kǎn",
      "upper": "坎",
      "lower": "坎",
      "lines": "010010",
      "structure": "上坎下坎",
      "judgment": "习坎，有孚，维心亨，行有尚。",
      "meaning": "重险习坎，维心亨通。水洊至，宜处险守诚、心亨行尚。"
    }
  },
  {
    "item_order": 30,
    "data": {
      "number": 30,
      "name": "离",
      "pinyin": "lí",
      "upper": "离",
      "lower": "离",
      "lines": "101101",
      "structure": "上离下离",
      "judgment": "利贞，亨。畜牝牛，吉。",
      "meaning": "附丽光明，明两作离。火相续，宜附丽正道、继明照于四方。"
    }
  },
  {
    "item_order": 31,
    "data": {
      "number": 31,
      "name": "咸",
      "pinyin": "xián",
      "upper": "兑",
      "lower": "艮",
      "lines": "011100",
      "structure": "上兑下艮",
      "judgment": "亨，利贞，取女吉。",
      "meaning": "感应交感，少男少女。山上有泽，宜以虚受人、感而遂通。"
    }
  },
  {
    "item_order": 32,
    "data": {
      "number": 32,
      "name": "恒",
      "pinyin": "héng",
      "upper": "震",
      "lower": "巽",
      "lines": "001110",
      "structure": "上震下巽",
      "judgment": "亨，无咎，利贞，利有攸往。",
      "meaning": "恒久不已，长久之道。雷风相与，宜持之以恒、循序渐进。"
    }
  },
  {
    "item_order": 33,
    "data": {
      "number": 33,
      "name": "遁",
      "pinyin": "dùn",
      "upper": "乾",
      "lower": "艮",
      "lines": "111100",
      "structure": "上乾下艮",
      "judgment": "亨，小利贞。",
      "meaning": "退避隐遁，明哲保身。天下有山，宜适时退隐、远小人。"
    }
  },
  {
    "item_order": 34,
    "data": {
      "number": 34,
      "name": "大壮",
      "pinyin": "dà zhuàng",
      "upper": "震",
      "lower": "乾",
      "lines": "001111",
      "structure": "上震下乾",
      "judgment": "利贞。",
      "meaning": "阳刚壮盛，壮勿妄动。雷在天上，宜壮而守礼、不可恃强。"
    }
  },
  {
    "item_order": 35,
    "data": {
      "number": 35,
      "name": "晋",
      "pinyin": "jìn",
      "upper": "离",
      "lower": "坤",
      "lines": "101000",
      "structure": "上离下坤",
      "judgment": "康侯用锡马蕃庶，昼日三接。",
      "meaning": "进长光明，显达向上。火在地上，宜进德修业、日渐昌明。"
    }
  },
  {
    "item_order": 36,
    "data": {
      "number": 36,
      "name": "明夷",
      "pinyin": "míng yí",
      "upper": "坤",
      "lower": "离",
      "lines": "000101",
      "structure": "上坤下离",
      "judgment": "利艰贞。",
      "meaning": "明入地中，韬光养晦。地中有火，宜处暗守正、内敛待明。"
    }
  },
  {
    "item_order": 37,
    "data": {
      "number": 37,
      "name": "家人",
      "pinyin": "jiā rén",
      "upper": "巽",
      "lower": "离",
      "lines": "110101",
      "structure": "上巽下离",
      "judgment": "利女贞。",
      "meaning": "家道正则，女主内。风自火出，宜齐家以礼、各正其位。"
    }
  },
  {
    "item_order": 38,
    "data": {
      "number": 38,
      "name": "睽",
      "pinyin": "kuí",
      "upper": "离",
      "lower": "兑",
      "lines": "101011",
      "structure": "上离下兑",
      "judgment": "小事吉。",
      "meaning": "乖离背反，求同存异。火泽相违，宜化睽为合、异中求同。"
    }
  },
  {
    "item_order": 39,
    "data": {
      "number": 39,
      "name": "蹇",
      "pinyin": "jiǎn",
      "upper": "坎",
      "lower": "艮",
      "lines": "010100",
      "structure": "上坎下艮",
      "judgment": "利西南，不利东北。利见大人，贞吉。",
      "meaning": "蹇难行止，反身修德。水在山上，宜止而思反、待时济难。"
    }
  },
  {
    "item_order": 40,
    "data": {
      "number": 40,
      "name": "解",
      "pinyin": "xiè",
      "upper": "震",
      "lower": "坎",
      "lines": "001010",
      "structure": "上震下坎",
      "judgment": "利西南，无所往，其来复吉。有攸往，夙吉。",
      "meaning": "险难消解，舒缓解散。雷雨作，宜解难纾困、与民休息。"
    }
  },
  {
    "item_order": 41,
    "data": {
      "number": 41,
      "name": "损",
      "pinyin": "sǔn",
      "upper": "艮",
      "lower": "兑",
      "lines": "100011",
      "structure": "上艮下兑",
      "judgment": "有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。",
      "meaning": "损下益上，损益有节。山下有泽，宜损抑私欲、与时偕行。"
    }
  },
  {
    "item_order": 42,
    "data": {
      "number": 42,
      "name": "益",
      "pinyin": "yì",
      "upper": "巽",
      "lower": "震",
      "lines": "110001",
      "structure": "上巽下震",
      "judgment": "利有攸往，利涉大川。",
      "meaning": "损上益下，与时偕行。风雷相助，宜施惠于下、迁善日进。"
    }
  },
  {
    "item_order": 43,
    "data": {
      "number": 43,
      "name": "夬",
      "pinyin": "guài",
      "upper": "兑",
      "lower": "乾",
      "lines": "011111",
      "structure": "上兑下乾",
      "judgment": "扬于王庭，孚号有厉。告自邑，不利即戎，利有攸往。",
      "meaning": "决而能和，刚决柔去。泽上于天，宜果决去奸、先自治。"
    }
  },
  {
    "item_order": 44,
    "data": {
      "number": 44,
      "name": "姤",
      "pinyin": "gòu",
      "upper": "乾",
      "lower": "巽",
      "lines": "111110",
      "structure": "上乾下巽",
      "judgment": "女壮，勿用取女。",
      "meaning": "不期而遇，阴长侵阳。天下有风，宜防微杜渐、慎处邂逅。"
    }
  },
  {
    "item_order": 45,
    "data": {
      "number": 45,
      "name": "萃",
      "pinyin": "cuì",
      "upper": "兑",
      "lower": "坤",
      "lines": "011000",
      "structure": "上兑下坤",
      "judgment": "亨。王假有庙，利见大人，亨，利贞。用大牲吉，利有攸往。",
      "meaning": "荟萃聚合，聚以正道。泽上于地，宜聚人聚财、以诚相萃。"
    }
  },
  {
    "item_order": 46,
    "data": {
      "number": 46,
      "name": "升",
      "pinyin": "shēng",
      "upper": "坤",
      "lower": "巽",
      "lines": "000110",
      "structure": "上坤下巽",
      "judgment": "元亨，用见大人，勿恤，南征吉。",
      "meaning": "积小成高，柔顺上升。地中生木，宜由下升上、步步高升。"
    }
  },
  {
    "item_order": 47,
    "data": {
      "number": 47,
      "name": "困",
      "pinyin": "kùn",
      "upper": "兑",
      "lower": "坎",
      "lines": "011010",
      "structure": "上兑下坎",
      "judgment": "亨，贞，大人吉，无咎。有言不信。",
      "meaning": "困穷守正，处困不挠。泽中无水，宜困而学、守正待变。"
    }
  },
  {
    "item_order": 48,
    "data": {
      "number": 48,
      "name": "井",
      "pinyin": "jǐng",
      "upper": "坎",
      "lower": "巽",
      "lines": "010110",
      "structure": "上坎下巽",
      "judgment": "改邑不改井，无丧无得，往来井井。汔至，亦未繘井，羸其瓶，凶。",
      "meaning": "井养不穷，养民有常。木上有水，宜惠民养德、常新不穷。"
    }
  },
  {
    "item_order": 49,
    "data": {
      "number": 49,
      "name": "革",
      "pinyin": "gé",
      "upper": "兑",
      "lower": "离",
      "lines": "011101",
      "structure": "上兑下离",
      "judgment": "巳日乃孚，元亨利贞，悔亡。",
      "meaning": "顺天应人，变革去故。泽中有火，宜顺时变革、去旧布新。"
    }
  },
  {
    "item_order": 50,
    "data": {
      "number": 50,
      "name": "鼎",
      "pinyin": "dǐng",
      "upper": "离",
      "lower": "巽",
      "lines": "101110",
      "structure": "上离下巽",
      "judgment": "元吉，亨。",
      "meaning": "鼎新取象，烹饪养贤。木上有火，宜革故鼎新、稳重图治。"
    }
  },
  {
    "item_order": 51,
    "data": {
      "number": 51,
      "name": "震",
      "pinyin": "zhèn",
      "upper": "震",
      "lower": "震",
      "lines": "001001",
      "structure": "上震下震",
      "judgment": "亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。",
      "meaning": "震动惊惧，恐惧修省。洊雷，宜临震不惊、反身修己。"
    }
  },
  {
    "item_order": 52,
    "data": {
      "number": 52,
      "name": "艮",
      "pinyin": "gěn",
      "upper": "艮",
      "lower": "艮",
      "lines": "100100",
      "structure": "上艮下艮",
      "judgment": "艮其背，不获其身，行其庭，不见其人，无咎。",
      "meaning": "止其所止，动静有时。兼山，宜止而安分、思不出位。"
    }
  },
  {
    "item_order": 53,
    "data": {
      "number": 53,
      "name": "渐",
      "pinyin": "jiàn",
      "upper": "巽",
      "lower": "艮",
      "lines": "110100",
      "structure": "上巽下艮",
      "judgment": "女归吉，利贞。",
      "meaning": "渐次有序，女归吉利。山上有木，宜循序渐进、稳进得正。"
    }
  },
  {
    "item_order": 54,
    "data": {
      "number": 54,
      "name": "归妹",
      "pinyin": "guī mèi",
      "upper": "震",
      "lower": "兑",
      "lines": "001011",
      "structure": "上震下兑",
      "judgment": "征凶，无攸利。",
      "meaning": "归妹失正，妄动有凶。泽上有雷，宜守分慎行、勿逾其位。"
    }
  },
  {
    "item_order": 55,
    "data": {
      "number": 55,
      "name": "丰",
      "pinyin": "fēng",
      "upper": "震",
      "lower": "离",
      "lines": "001101",
      "structure": "上震下离",
      "judgment": "亨，王假之，勿忧，宜日中。",
      "meaning": "丰大盛明，日中则昃。雷电皆至，宜盛极戒满、修德保丰。"
    }
  },
  {
    "item_order": 56,
    "data": {
      "number": 56,
      "name": "旅",
      "pinyin": "lǚ",
      "upper": "离",
      "lower": "艮",
      "lines": "101100",
      "structure": "上离下艮",
      "judgment": "小亨，旅贞吉。",
      "meaning": "行旅在外，柔顺得安。山上有火，宜羁旅守慎、低调自安。"
    }
  },
  {
    "item_order": 57,
    "data": {
      "number": 57,
      "name": "巽",
      "pinyin": "xùn",
      "upper": "巽",
      "lower": "巽",
      "lines": "110110",
      "structure": "上巽下巽",
      "judgment": "小亨，利有攸往，利见大人。",
      "meaning": "顺而入之，申命行权。随风，宜谦顺以行、渐进得入。"
    }
  },
  {
    "item_order": 58,
    "data": {
      "number": 58,
      "name": "兑",
      "pinyin": "duì",
      "upper": "兑",
      "lower": "兑",
      "lines": "011011",
      "structure": "上兑下兑",
      "judgment": "亨，利贞。",
      "meaning": "和悦相说，朋友讲习。丽泽，宜以悦待人、和乐相长。"
    }
  },
  {
    "item_order": 59,
    "data": {
      "number": 59,
      "name": "涣",
      "pinyin": "huàn",
      "upper": "巽",
      "lower": "坎",
      "lines": "110010",
      "structure": "上巽下坎",
      "judgment": "亨。王假有庙，利涉大川，利贞。",
      "meaning": "涣散可聚，风行水上。风行水，宜涣释离散、凝聚人心。"
    }
  },
  {
    "item_order": 60,
    "data": {
      "number": 60,
      "name": "节",
      "pinyin": "jié",
      "upper": "坎",
      "lower": "兑",
      "lines": "010011",
      "structure": "上坎下兑",
      "judgment": "亨。苦节不可贞。",
      "meaning": "节制有度，苦节不可。泽上有水，宜节而中礼、不可过苦。"
    }
  },
  {
    "item_order": 61,
    "data": {
      "number": 61,
      "name": "中孚",
      "pinyin": "zhōng fú",
      "upper": "巽",
      "lower": "兑",
      "lines": "110011",
      "structure": "上巽下兑",
      "judgment": "豚鱼吉，利涉大川，利贞。",
      "meaning": "中心诚信，豚鱼可格。泽上有风，宜内诚外信、以信感人。"
    }
  },
  {
    "item_order": 62,
    "data": {
      "number": 62,
      "name": "小过",
      "pinyin": "xiǎo guò",
      "upper": "震",
      "lower": "艮",
      "lines": "001100",
      "structure": "上震下艮",
      "judgment": "亨，利贞，可小事，不可大事。飞鸟遗之音，不宜上宜下，大吉。",
      "meaning": "小者过越，宜下不宜。山上有雷，宜行小过、守分谨微。"
    }
  },
  {
    "item_order": 63,
    "data": {
      "number": 63,
      "name": "既济",
      "pinyin": "jì jì",
      "upper": "坎",
      "lower": "离",
      "lines": "010101",
      "structure": "上坎下离",
      "judgment": "亨，小利贞，初吉终乱。",
      "meaning": "事已成济，初吉终乱。水在火上，宜既济思未济、守成防变。"
    }
  },
  {
    "item_order": 64,
    "data": {
      "number": 64,
      "name": "未济",
      "pinyin": "wèi jì",
      "upper": "离",
      "lower": "坎",
      "lines": "101010",
      "structure": "上离下坎",
      "judgment": "亨，小狐汔济，濡其尾，无攸利。",
      "meaning": "事未竟成，慎终如始。火在水上，宜慎终如始、进取未竟。"
    }
  }
]